# AI Orchestration System — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ---------------------------------------------------------------
# Required: API Keys
# ---------------------------------------------------------------

# OpenAI API key — used by Architect, Planner, and Reviewer roles
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API key — used by the Executor role
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ---------------------------------------------------------------
# Optional: Model Selection
# ---------------------------------------------------------------

# OpenAI model for Architect/Planner/Reviewer (default: gpt-4o)
# OPENAI_MODEL=gpt-4o

# Claude model for Executor (default: claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------
# Optional: GitHub Integration
# ---------------------------------------------------------------

# Your GitHub personal access token (needed for PR creation)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp-your-github-token-here

# Repository in owner/repo format
GITHUB_REPO=evhedric/ai-build-system

# Set to "true" to automatically create a PR when a task is approved
AUTO_CREATE_PR=false

# ---------------------------------------------------------------
# Optional: Runner Behavior
# ---------------------------------------------------------------

# Maximum revision cycles before a task is marked failed (default: 3)
MAX_REVISIONS=3

# Seconds between polling /tasks for new work (default: 3)
POLL_INTERVAL=3
