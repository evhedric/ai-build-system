{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "execution_result",
  "title": "Execution Result Packet",
  "description": "The output produced by the Executor after running a plan",
  "type": "object",
  "required": ["task_id", "executed_at", "branch_name", "steps_completed", "summary"],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "branch_name": {
      "type": "string"
    },
    "steps_completed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_id", "status"],
        "properties": {
          "step_id": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": ["completed", "failed", "skipped"]
          },
          "output": {
            "type": "string",
            "description": "Standard output or result of the step"
          },
          "error": {
            "type": ["string", "null"],
            "description": "Error message if step failed"
          }
        },
        "additionalProperties": false
      }
    },
    "files_created": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Relative paths of files created during execution"
    },
    "files_modified": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Relative paths of files modified during execution"
    },
    "summary": {
      "type": "string",
      "description": "Human-readable summary of what was accomplished"
    },
    "issues_encountered": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Any non-fatal issues that occurred during execution"
    }
  },
  "additionalProperties": false
}
